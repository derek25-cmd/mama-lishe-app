# ============================================================
# FAIDA — cloud environment template
# cp .env.example .env  then fill in real values. NEVER commit .env
# Generate strong secrets with:  openssl rand -base64 32
# ============================================================

# ---------- PostgreSQL ----------
# For the single-VM deploy (docker-compose's own `postgres` service):
#   DATABASE_URL=postgres://faida:${POSTGRES_PASSWORD}@postgres:5432/faida
# For a managed instance (RDS/Cloud SQL/Neon) instead, point DATABASE_URL at
# it directly and remove the `postgres` service from docker-compose.yml.
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand
DATABASE_URL=postgres://faida:CHANGE_ME_openssl_rand@postgres:5432/faida

# ---------- Redis ----------
# docker-compose's own `redis` service by default; point at a managed
# instance (ElastiCache/Upstash) instead for a non-single-VM deploy.
REDIS_URL=redis://redis:6379

# ---------- Auth: JWT + OAuth 2.0 ----------
JWT_SECRET=CHANGE_ME_openssl_rand_KEEP_SAFE
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL_DAYS=30
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://api.your-domain.com/api/v1/auth/callback

# ---------- AWS S3 ----------
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_MEDIA=faida-media
S3_BUCKET_EXPORTS=faida-exports

# ---------- Notifications ----------
# Firebase Cloud Messaging (service-account JSON, base64-encoded)
FCM_SERVICE_ACCOUNT_B64=
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Faida <no-reply@your-domain.com>"
# SMS (Beem Africa)
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=FAIDA

# ---------- Monitoring ----------
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
